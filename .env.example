# Copy to .env for local runs (never commit .env). On Netlify, set these in the site's environment variables.

# Base URL of the MTI CRM (no trailing path). The proxy posts to {CRM_URL}/api/website/leads.
CRM_URL=https://crm.example.com

# Shared secret issued by the CRM team. Sent only server-side as the X-Website-Secret header.
WEBSITE_FORM_SECRET=replace-with-the-secret-from-the-crm-team

# Optional: comma-separated list of origins allowed to post to /api/contact.
# When empty, the request Origin must match the Host header (same-origin only).
ALLOWED_ORIGINS=

# Node server only (server/node-server.mjs)
PORT=8080
# Set to 1 when running behind nginx/Caddy so the per-IP limit uses X-Forwarded-For.
TRUST_PROXY=0
# Requests per IP per 10 minutes to /api/contact (default 5).
CONTACT_RATE_MAX=5
