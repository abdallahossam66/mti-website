{
  "name": "mti-website",
  "version": "1.0.0",
  "private": true,
  "description": "Public website of MTI AI SOLUTIONS",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "build:check": "node scripts/build-site.mjs --check",
    "start": "node server/node-server.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:php": "node tests/php-smoke.mjs",
    "validate:html": "node scripts/validate-html.mjs",
    "check:links": "node scripts/check-links.mjs",
    "contrast": "node scripts/contrast.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "qa": "node scripts/qa.mjs",
    "build:og": "node scripts/build-og-image.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:countries": "node scripts/gen-countries.mjs",
    "verify:fixture": "node scripts/verify-fixture.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "lighthouse": "^12.8.2",
    "linkinator": "^6.3.0",
    "lucide-static": "^1.66.0",
    "vnu-jar": "^26.10.12"
  }
}
